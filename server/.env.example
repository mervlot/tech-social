# ───────────────────────── Server ─────────────────────────
NODE_ENV=development
# Bind to all interfaces so a phone on the same Wi-Fi can reach the API.
HOST=0.0.0.0
PORT=4000
# Public URL where the API is reachable (used to build absolute media URLs)
API_URL=http://localhost:4000
# Comma-separated list of allowed CORS origins (the frontend dev server)
CLIENT_URL=http://localhost:5173

# ──────────────────────── Database ────────────────────────
# Requires Node.js 22.5+ for the built-in node:sqlite module.
# Default: file-based SQLite (zero install).
# The database is stored at server/data/social-network.db.
DATABASE_URL="file:./data/social-network.db"
# SQLite is the only supported database for this Termux build.

# ────────────────────────── Auth ──────────────────────────
# Use long, random strings in production (e.g. `openssl rand -hex 64`)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Google OAuth sign-in. Create credentials in Google Cloud Console and set
# the redirect URI to http://localhost:4000/api/auth/google/callback locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Password reset email. For Gmail, use a 16-character App Password, not the
# normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=murmursoc@gmail.com
SMTP_PASS=
MAIL_FROM=murmursoc@gmail.com

# ───────────────────────── Uploads ────────────────────────
# Where uploaded media is stored on disk (relative to server root)
UPLOAD_DIR=uploads
# Max upload size in megabytes
MAX_UPLOAD_MB=25

# Optional persistent cloud storage. Set all three values in production.
# When omitted, files continue to be stored locally under UPLOAD_DIR.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=murmur
